package views

import (
	"github.com/rm4n0s/clowder/internal/app"
	"strconv"
)

// SidebarData is what the shell of a logged-in page shows: the header and the
// sidebar of rooms.
type SidebarData struct {
	// User is the logged-in user.
	User app.User
	// Rooms are the rooms the user is a member of, in the order to show.
	Rooms []app.Room
	// CurrentRoomID is the ID of the room whose page is shown, which the
	// sidebar highlights; 0 on every other page.
	CurrentRoomID uint64
	// Unread is the number of unread notifications of the user, shown on the
	// bell; the badge is left out when it is 0.
	Unread int
	// UnreadMessages is the number of conversations of the user with unread
	// messages, shown on the Messages link of the header; the badge is left out
	// when it is 0.
	UnreadMessages int
	// HideSearch leaves out the search box of the header. The search page
	// sets it: it has a box of its own.
	HideSearch bool
	// Theme is the theme of the user, which the theme form of the user menu
	// marks; empty means System.
	Theme app.Theme
}

// PageHeader is the header element of the pages of a logged-in user, with
// its content (Header). The streams patch it together with PageSidebar, by
// their ids.
templ PageHeader(d SidebarData) {
	<header id="site-header" class="site-header">
		@Header(d)
	</header>
}

// PageSidebar is the aside element of the pages of a logged-in user, with the
// rooms (Sidebar). It is a popover (SPEC D58): above 40 rem app.css draws it as
// the column beside the page, at 40 rem and below as a drawer from the left that
// the menu button of the header (Header) opens, with the close button in front
// of the rooms (hidden in the column). The close button has autofocus, which is
// what makes the browser move the focus into the drawer when it opens.
templ PageSidebar(d SidebarData) {
	<aside id="sidebar" popover>
		<div class="drawer-head">
			<p class="drawer-title" aria-hidden="true">Rooms</p>
			<button type="button" class="drawer-close" popovertarget="sidebar" popovertargetaction="hide" autofocus>
				@IconClose()
				<span class="visually-hidden">Close the room menu</span>
			</button>
		</div>
		@Sidebar(d)
	</aside>
}

// Header is the content of the header of the pages of a logged-in user: the
// menu button that opens the drawer of rooms on a phone (hidden above 40 rem;
// its dot, and the word "unread" in its name, show while a room has unread
// posts or mentions, by CSS from the list of rooms itself, so that the patch of
// a single room keeps them right), the logo (a link to the home page), the search box (left out when HideSearch is
// set), the bell with the unread notifications, Messages with the conversations
// that have unread messages (both links, with the counts that the streams patch
// by their ids) and the user menu.
templ Header(d SidebarData) {
	<button type="button" id="menu-button" class="menu-button" popovertarget="sidebar" aria-controls="sidebar">
		@IconMenu()
		<span class="menu-dot" aria-hidden="true"></span>
		<span class="visually-hidden">Rooms</span>
		<span class="visually-hidden menu-unread-name">, with unread posts</span>
	</button>
	@Logo()
	if !d.HideSearch {
		@SearchBar()
	}
	<div class="header-actions">
		<a class="header-link header-notifications" href="/notifications">
			@IconBell()
			<span class="visually-hidden">Notifications</span>
			@NotificationCount(d.Unread)
		</a>
		<a class="header-link header-messages" href="/messages">
			@IconMessage()
			<span class="visually-hidden">Messages</span>
			@MessageCount(d.UnreadMessages)
		</a>
		@UserMenu(d)
	</div>
}

// UserMenu is the menu of the user, a details element without script: the
// avatar opens a panel with the name, Settings, the theme (ThemeMenu),
// Sessions, Admin (for admins only) and the logout form. The details element
// keeps its open state when a stream patches the header (data-preserve-attr).
templ UserMenu(d SidebarData) {
	<details class="user-menu" id="user-menu" data-preserve-attr="open">
		<summary class="user-menu-button" aria-label="Account menu">
			<span id="header-avatar">
				@AvatarSized(d.User.ID, d.User.DisplayName, d.User.AvatarURL(), "md")
			</span>
		</summary>
		<div class="user-menu-panel">
			<p class="user-menu-name" id="sidebar-user">{ d.User.DisplayName }</p>
			<a class="user-menu-item" href={ templ.SafeURL(SettingsPath) }>
				@IconSettings()
				Settings
			</a>
			@ThemeMenu(d.Theme)
			<a class="user-menu-item" href={ templ.SafeURL(SettingsSessionsPath) }>
				@IconLock()
				Sessions
			</a>
			if d.User.IsAdmin() {
				<a class="user-menu-item" href="/admin/users">
					@IconBoard()
					Admin
				</a>
			}
			<form id="logout-form" class="user-menu-logout" method="post" action="/logout" data-on:submit={ FormPost("/logout") }>
				<button type="submit" class="user-menu-item">
					@IconLogout()
					Log out
				</button>
			</form>
		</div>
	</details>
}

// SettingsAppearanceMenuPath is the route that saves the theme, as the form of
// the user menu posts to it: the query from=menu makes the answer patch the
// menu and not the Appearance section, which is not on most pages.
const SettingsAppearanceMenuPath = SettingsAppearancePath + "?from=menu"

// ThemeMenu is the small form of the user menu that picks the theme: System,
// Light or Dark, three buttons that post to the Appearance route of the
// settings (the query from=menu tells it to answer for the menu). The current choice has
// aria-pressed="true". The server sends it alone as a Datastar patch after the
// choice, which also sets data-theme on the page.
templ ThemeMenu(theme app.Theme) {
	<form id="theme-menu" class="theme-menu" method="post" action={ templ.SafeURL(SettingsAppearanceMenuPath) } data-on:submit={ FormPost(SettingsAppearanceMenuPath) }>
		<p class="theme-menu-label" id="theme-menu-label">Theme</p>
		<div class="theme-menu-choices" role="group" aria-labelledby="theme-menu-label">
			for _, c := range themeChoices() {
				<button type="submit" name="theme" value={ string(c.Theme) } class={ "theme-option", templ.KV("current", themeSelected(theme, c.Theme)) } aria-pressed={ strconv.FormatBool(themeSelected(theme, c.Theme)) }>
					switch c.Theme {
						case app.ThemeLight:
							@IconSun()
						case app.ThemeDark:
							@IconMoon()
						default:
							@IconMonitor()
					}
					{ c.Label }
				</button>
			}
		</div>
	</form>
}

// themeSelected reports whether choice is the theme in use: an empty theme is
// System, like any value that is not Light or Dark.
func themeSelected(theme, choice app.Theme) bool {
	if theme != app.ThemeLight && theme != app.ThemeDark {
		theme = app.ThemeSystem
	}
	return theme == choice
}

// Sidebar is the sidebar of the pages of a logged-in user: the rooms of the
// user with the counts of 20.2, and the links to browse and to make rooms.
// Everything else the old sidebar held is in the header (Header).
templ Sidebar(d SidebarData) {
	<nav aria-label="Rooms" id="sidebar-rooms">
		<h2 class="sidebar-heading">Your rooms</h2>
		<ul class="sidebar-room-list">
			for _, room := range d.Rooms {
				@SidebarRoom(room, d.CurrentRoomID)
			}
		</ul>
		<ul class="sidebar-room-links">
			<li><a href="/rooms">Browse rooms</a></li>
			<li><a href="/rooms/new">New room</a></li>
		</ul>
	</nav>
}

// SidebarRoom is the list item of one room in the sidebar: the link with the
// name, then what is waiting in it (SPEC §7.17). A room with unread posts is
// bold and shows their number ("99+" above 99); a room set to count only
// mentions is not bold and shows only the badge of the mentions; a muted room
// is dimmed and shows only the badge of the mentions. A mention badge appears
// whenever the room has unread mentions. The item has an id so that the stream
// can patch it alone when the counts of the room change.
templ SidebarRoom(room app.Room, current uint64) {
	<li id={ sidebarRoomID(room.ID) } class={ sidebarRoomClasses(room) }>
		<a
			href={ templ.SafeURL(RoomPath(room.ID)) }
			class={ templ.KV("current", room.ID == current) }
			data-room={ room.Name }
			if room.ID == current {
				aria-current="page"
			}
		>
			if room.Visibility == app.VisibilityPrivate {
				@lockIcon()
			}
			{ room.Name }
			if room.Muted {
				@mutedIcon()
			}
		</a>
		if n := roomUnreadPosts(room); n > 0 {
			<span class="count-badge room-unread" title={ unreadPostsTitle(n) }>{ unreadLabel(n) }</span>
		}
		if room.UnreadMentions > 0 {
			<span class="count-badge mention-badge" title={ unreadMentionsTitle(room.UnreadMentions) }>{ unreadLabel(room.UnreadMentions) }</span>
		}
	</li>
}

// NotificationCount is the badge with the number of unread notifications, on
// the bell of the header. The element is always there, so that
// a patch finds it; it is empty, and not shown, when the count is 0.
templ NotificationCount(n int) {
	if n > 0 {
		<span id="notification-count" class="count-badge" title={ unreadTitle(n) }>{ strconv.Itoa(n) }</span>
	} else {
		<span id="notification-count" class="count-badge"></span>
	}
}

// MessageCount is the badge with the number of conversations that have unread
// messages, on the Messages link of the header. The element is always there,
// so that a patch finds it; it is empty, and not shown, when the count is 0.
templ MessageCount(n int) {
	if n > 0 {
		<span id="message-count" class="count-badge" title={ unreadConversationsTitle(n) }>{ strconv.Itoa(n) }</span>
	} else {
		<span id="message-count" class="count-badge"></span>
	}
}

// unreadTitle is "1 unread notification" or "5 unread notifications".
func unreadTitle(n int) string {
	if n == 1 {
		return "1 unread notification"
	}
	return strconv.Itoa(n) + " unread notifications"
}

// lockIcon is the small padlock that marks a private room.
templ lockIcon() {
	<svg class="lock" role="img" aria-label="Private" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
		<rect x="4" y="11" width="16" height="10" rx="2"></rect>
		<path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
	</svg>
}

// roomIDText is the decimal text of a room ID, for ids of elements.
func roomIDText(id uint64) string {
	return strconv.FormatUint(id, 10)
}
