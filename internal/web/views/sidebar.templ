package views

import (
	"github.com/rm4n0s/clowder/internal/app"
	"strconv"
)

// SidebarData is what the sidebar of a logged-in page shows.
type SidebarData struct {
	// User is the logged-in user.
	User app.User
	// Rooms are the rooms the user is a member of, in the order to show.
	Rooms []app.Room
	// CurrentRoomID is the ID of the room whose page is shown, which the
	// sidebar highlights; 0 on every other page.
	CurrentRoomID uint64
	// HideSearch leaves out the search box of the sidebar. The search page
	// sets it: it has a box of its own.
	HideSearch bool
}

// Sidebar is the sidebar of the pages of a logged-in user: the display name of
// the user, the search box, the navigation (Home, and Admin for admins), the
// rooms of the user with the links to browse and to make rooms, and the logout
// button.
templ Sidebar(d SidebarData) {
	<p class="sidebar-user" id="sidebar-user">{ d.User.DisplayName }</p>
	if !d.HideSearch {
		@SearchBar()
	}
	<nav aria-label="Main">
		<ul>
			<li><a href="/">Home</a></li>
			if d.User.IsAdmin() {
				<li><a href="/admin/users">Admin</a></li>
			}
		</ul>
	</nav>
	<nav aria-label="Rooms" id="sidebar-rooms">
		<h2 class="sidebar-heading">Rooms</h2>
		<ul class="sidebar-room-list">
			for _, room := range d.Rooms {
				<li>
					<a
						href={ templ.SafeURL(RoomPath(room.ID)) }
						class={ templ.KV("current", room.ID == d.CurrentRoomID) }
						data-room={ room.Name }
						if room.ID == d.CurrentRoomID {
							aria-current="page"
						}
					>
						if room.Visibility == app.VisibilityPrivate {
							@lockIcon()
						}
						{ room.Name }
					</a>
				</li>
			}
		</ul>
		<ul class="sidebar-room-links">
			<li><a href="/rooms">Browse rooms</a></li>
			<li><a href="/rooms/new">New room</a></li>
		</ul>
	</nav>
	<form id="logout-form" method="post" action="/logout" data-on:submit={ FormPost("/logout") }>
		<button type="submit" class="secondary">Log out</button>
	</form>
}

// lockIcon is the small padlock that marks a private room.
templ lockIcon() {
	<svg class="lock" role="img" aria-label="Private" width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
		<path d="M8 1a3 3 0 0 0-3 3v2H4a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-1V4a3 3 0 0 0-3-3Zm-1.5 3a1.5 1.5 0 0 1 3 0v2h-3V4Z"></path>
	</svg>
}

// roomIDText is the decimal text of a room ID, for ids of elements.
func roomIDText(id uint64) string {
	return strconv.FormatUint(id, 10)
}
