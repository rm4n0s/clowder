package views

import (
	"github.com/rm4n0s/clowder/internal/app"
	"strconv"
)

// SidebarData is what the sidebar of a logged-in page shows.
type SidebarData struct {
	// User is the logged-in user.
	User app.User
	// Rooms are the rooms the user is a member of, in the order to show.
	Rooms []app.Room
	// CurrentRoomID is the ID of the room whose page is shown, which the
	// sidebar highlights; 0 on every other page.
	CurrentRoomID uint64
	// Unread is the number of unread notifications of the user, shown on the
	// Notifications link; the badge is left out when it is 0.
	Unread int
	// UnreadMessages is the number of conversations of the user with unread
	// messages, shown on the Messages link; the badge is left out when it is 0.
	UnreadMessages int
	// HideSearch leaves out the search box of the sidebar. The search page
	// sets it: it has a box of its own.
	HideSearch bool
}

// Sidebar is the sidebar of the pages of a logged-in user: the display name of
// the user with their avatar (a link to the settings), the search box, the navigation (Home, Messages and Notifications with
// their unread counts, and Admin for admins), the
// rooms of the user with the links to browse and to make rooms, and the logout
// button.
templ Sidebar(d SidebarData) {
	<div class="sidebar-profile" id="sidebar-profile">
		<a class="sidebar-avatar" href={ templ.SafeURL(SettingsPath) } title="Settings" aria-label="Settings">
			@AvatarSized(d.User.ID, d.User.DisplayName, d.User.AvatarURL(), "md")
		</a>
		<p class="sidebar-user" id="sidebar-user">{ d.User.DisplayName }</p>
	</div>
	<p class="sidebar-account"><a href={ templ.SafeURL(SettingsPath) }>Settings</a></p>
	if !d.HideSearch {
		@SearchBar()
	}
	<nav aria-label="Main">
		<ul>
			<li><a href="/">Home</a></li>
			<li>
				<a class="sidebar-messages" href="/messages">
					<span>Messages</span>
					@MessageCount(d.UnreadMessages)
				</a>
			</li>
			<li>
				<a class="sidebar-notifications" href="/notifications">
					<span>Notifications</span>
					@NotificationCount(d.Unread)
				</a>
			</li>
			if d.User.IsAdmin() {
				<li><a href="/admin/users">Admin</a></li>
			}
		</ul>
	</nav>
	<nav aria-label="Rooms" id="sidebar-rooms">
		<h2 class="sidebar-heading">Rooms</h2>
		<ul class="sidebar-room-list">
			for _, room := range d.Rooms {
				<li class={ templ.KV("muted", room.Muted) }>
					<a
						href={ templ.SafeURL(RoomPath(room.ID)) }
						class={ templ.KV("current", room.ID == d.CurrentRoomID) }
						data-room={ room.Name }
						if room.ID == d.CurrentRoomID {
							aria-current="page"
						}
					>
						if room.Visibility == app.VisibilityPrivate {
							@lockIcon()
						}
						{ room.Name }
						if room.Muted {
							@mutedIcon()
						}
					</a>
					// TODO(step 20.2): a muted room shows only a badge with its unread mentions.
				</li>
			}
		</ul>
		<ul class="sidebar-room-links">
			<li><a href="/rooms">Browse rooms</a></li>
			<li><a href="/rooms/new">New room</a></li>
		</ul>
	</nav>
	<form id="logout-form" method="post" action="/logout" data-on:submit={ FormPost("/logout") }>
		<button type="submit" class="secondary">Log out</button>
	</form>
}

// NotificationCount is the badge with the number of unread notifications, on
// the Notifications link of the sidebar. The element is always there, so that
// a patch finds it; it is empty, and not shown, when the count is 0.
templ NotificationCount(n int) {
	if n > 0 {
		<span id="notification-count" class="count-badge" title={ unreadTitle(n) }>{ strconv.Itoa(n) }</span>
	} else {
		<span id="notification-count" class="count-badge"></span>
	}
}

// MessageCount is the badge with the number of conversations that have unread
// messages, on the Messages link of the sidebar. The element is always there,
// so that a patch finds it; it is empty, and not shown, when the count is 0.
templ MessageCount(n int) {
	if n > 0 {
		<span id="message-count" class="count-badge" title={ unreadConversationsTitle(n) }>{ strconv.Itoa(n) }</span>
	} else {
		<span id="message-count" class="count-badge"></span>
	}
}

// unreadTitle is "1 unread notification" or "5 unread notifications".
func unreadTitle(n int) string {
	if n == 1 {
		return "1 unread notification"
	}
	return strconv.Itoa(n) + " unread notifications"
}

// lockIcon is the small padlock that marks a private room.
templ lockIcon() {
	<svg class="lock" role="img" aria-label="Private" width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
		<path d="M8 1a3 3 0 0 0-3 3v2H4a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-1V4a3 3 0 0 0-3-3Zm-1.5 3a1.5 1.5 0 0 1 3 0v2h-3V4Z"></path>
	</svg>
}

// roomIDText is the decimal text of a room ID, for ids of elements.
func roomIDText(id uint64) string {
	return strconv.FormatUint(id, 10)
}
