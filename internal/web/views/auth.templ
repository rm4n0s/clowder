package views

import "strconv"

// LoginData is what the login page and its form show.
type LoginData struct {
	// Username is the username typed in the last submit. The password is
	// never put back.
	Username string
	// Next is the local path to go to after the login, already checked; empty
	// means the home page.
	Next string
	// Errors are the problems of the last submit.
	Errors FormErrors
}

// LoginPage is the page of the login form.
templ LoginPage(d LoginData) {
	@Layout("Log in", 0, nil) {
		<div class="auth-card">
			<h1>Log in</h1>
			@LoginForm(d)
		</div>
	}
}

// LoginForm is the login form. The server sends it alone as a Datastar patch
// to show the problems of a failed login; it replaces the element with the
// same id.
templ LoginForm(d LoginData) {
	<form id="login-form" method="post" action="/login" data-on:submit={ FormPost("/login") }>
		@formProblem(d.Errors.Form)
		@inputField(formField{ID: "login-username", Name: "username", Label: "Username", Type: "text", Value: d.Username, Autocomplete: "username", Error: d.Errors.Fields["username"], Autofocus: true})
		@inputField(formField{ID: "login-password", Name: "password", Label: "Password", Type: "password", Autocomplete: "current-password", Error: d.Errors.Fields["password"]})
		if d.Next != "" {
			<input type="hidden" name="next" value={ d.Next }/>
		}
		<button type="submit">Log in</button>
	</form>
}

// LoginCodeData is what the second form of the login shows: the code of the
// SSH server (SPEC §7.16).
type LoginCodeData struct {
	// Command is the ssh command that fetches a code for the user of the
	// pending login, such as "ssh -p 2222 alice@chat.example.org"; empty when
	// this Clowder shows none.
	Command string
	// Errors are the problems of the last submit, under the field "code".
	Errors FormErrors
}

// LoginCodePath is the page and the form of the second step of the login.
const LoginCodePath = "/login/code"

// LoginCodeRestartPath is the "Start again" link of the second step.
const LoginCodeRestartPath = "/login/code/restart"

// LoginCodePage is the page of the second form of the login, which asks for
// the SSH code after the right password.
templ LoginCodePage(d LoginCodeData) {
	@Layout("Log in", 0, nil) {
		<div class="auth-card">
			<h1>Enter your code</h1>
			@LoginCodeForm(d)
		</div>
	}
}

// LoginCodeForm is the form of the SSH code. The server sends it alone as a
// Datastar patch to show a wrong code; it replaces the element with the same
// id.
templ LoginCodeForm(d LoginCodeData) {
	<form id="login-code-form" method="post" action={ templ.SafeURL(LoginCodePath) } data-on:submit={ FormPost(LoginCodePath) }>
		@formProblem(d.Errors.Form)
		if d.Command != "" {
			<p>Run <code id="login-code-command" class="ssh-command">{ d.Command }</code> and type the code.</p>
		} else {
			<p>Fetch a code with one of your SSH keys and type it.</p>
		}
		@inputField(formField{ID: "login-code", Name: "code", Label: "Code", Type: "text", Autocomplete: "one-time-code", Autocapitalize: "characters", NoSpellcheck: true, MaxLength: 9, Error: d.Errors.Fields["sshCode"], Autofocus: true})
		<button type="submit">Log in</button>
		<p class="hint login-code-restart"><a id="login-code-restart" href={ templ.SafeURL(LoginCodeRestartPath) }>Start again</a></p>
	</form>
}

// SignUpData is what the sign-up page and its form show.
type SignUpData struct {
	// Token is the token of the invitation, from the link.
	Token string
	// Username and DisplayName are the values typed in the last submit. The
	// password is never put back.
	Username    string
	DisplayName string
	// Errors are the problems of the last submit.
	Errors FormErrors
}

// SignUpPage is the page of the sign-up form of an invitation.
templ SignUpPage(d SignUpData) {
	@Layout("Sign up", 0, nil) {
		<div class="auth-card">
			<h1>Join Clowder</h1>
			@SignUpForm(d)
		</div>
	}
}

// SignUpForm is the sign-up form. The server sends it alone as a Datastar
// patch to show the problems of a failed submit.
templ SignUpForm(d SignUpData) {
	<form id="signup-form" method="post" action={ templ.SafeURL(invitePath(d.Token)) } data-on:submit={ FormPost(invitePath(d.Token)) }>
		@formProblem(d.Errors.Form)
		@inputField(formField{ID: "signup-username", Name: "username", Label: "Username", Type: "text", Value: d.Username, Autocomplete: "username", Error: d.Errors.Fields["username"], Autofocus: true, Hint: "3 to 32 characters: a to z, digits, _ and -."})
		@inputField(formField{ID: "signup-display-name", Name: "displayName", Label: "Display name", Type: "text", Value: d.DisplayName, Autocomplete: "name", Error: d.Errors.Fields["displayName"]})
		@inputField(formField{ID: "signup-password", Name: "password", Label: "Password", Type: "password", Autocomplete: "new-password", Error: d.Errors.Fields["password"], Hint: "At least 12 characters."})
		<button type="submit">Create account</button>
	</form>
}

// ResetData is what the page of a password reset link and its form show.
type ResetData struct {
	// Token is the token of the link, from the address.
	Token string
	// Errors are the problems of the last submit. The passwords are never
	// put back.
	Errors FormErrors
}

// ResetPage is the page of the form that sets a new password with a reset
// link.
templ ResetPage(d ResetData) {
	@Layout("Set a new password", 0, nil) {
		<div class="auth-card">
			<h1>Set a new password</h1>
			@ResetForm(d)
		</div>
	}
}

// ResetForm is the form of a reset link. The server sends it alone as a
// Datastar patch to show the problems of a failed submit.
templ ResetForm(d ResetData) {
	<form id="reset-form" method="post" action={ templ.SafeURL(resetPath(d.Token)) } data-on:submit={ FormPost(resetPath(d.Token)) }>
		@formProblem(d.Errors.Form)
		@inputField(formField{ID: "reset-password", Name: "password", Label: "New password", Type: "password", Autocomplete: "new-password", Error: d.Errors.Fields["password"], Hint: "At least 12 characters.", Autofocus: true})
		@inputField(formField{ID: "reset-password-confirm", Name: "passwordConfirm", Label: "New password again", Type: "password", Autocomplete: "new-password", Error: d.Errors.Fields["passwordConfirm"]})
		<button type="submit">Set the password and log in</button>
	</form>
}

// formProblem shows the problem of a whole form, if there is one.
templ formProblem(message string) {
	if message != "" {
		<p class="form-error" role="alert">{ message }</p>
	}
}

// inputField is a label, an input and, when it has one, the message of its
// problem next to it.
templ inputField(f formField) {
	<div class="field">
		<label for={ f.ID }>{ f.Label }</label>
		<input
			id={ f.ID }
			name={ f.Name }
			type={ f.Type }
			if f.Type != "password" {
				value={ f.Value }
			}
			autocomplete={ f.Autocomplete }
			if f.Autocapitalize != "" {
				autocapitalize={ f.Autocapitalize }
			}
			if f.NoSpellcheck {
				spellcheck="false"
			}
			if f.MaxLength > 0 {
				maxlength={ strconv.Itoa(f.MaxLength) }
			}
			required
			if f.Autofocus {
				autofocus
			}
			if f.Error != "" {
				aria-invalid="true"
				aria-describedby={ f.ID + "-error" }
			}
		/>
		if f.Error != "" {
			<p class="field-error" id={ f.ID + "-error" } role="alert">{ f.Error }</p>
		} else if f.Hint != "" {
			<p class="hint">{ f.Hint }</p>
		}
	</div>
}
