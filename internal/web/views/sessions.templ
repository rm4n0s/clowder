package views

import (
	"strconv"

	"github.com/rm4n0s/clowder/internal/app"
)

// SessionsPath is the page of the sessions of the logged-in user.
const SessionsPath = "/me/sessions"

// SessionEndPath is the path that ends the session with the id.
func SessionEndPath(id uint64) string {
	return SessionsPath + "/" + strconv.FormatUint(id, 10) + "/end"
}

// SessionsData is what the page of the sessions shows.
type SessionsData struct {
	// Sidebar is the sidebar of the page.
	Sidebar SidebarData
	// Sessions are the live sessions of the user, the newest first.
	Sessions []app.SessionInfo
}

// SessionsPage is the page of the sessions of the user: every browser and
// every app that is logged in, with when it was made and last used, the one
// that shows the page marked, and a button to end each of them. Ending the
// session of the page logs it out.
templ SessionsPage(d SessionsData) {
	@Layout("Sessions", Sidebar(d.Sidebar)) {
		<h1>Sessions</h1>
		<p class="hint">These are the browsers and apps that are logged in to your account. End a session to log that browser or app out.</p>
		<section id="sessions-panel">
			<table class="sessions">
				<thead>
					<tr>
						<th scope="col">Type</th>
						<th scope="col">Client</th>
						<th scope="col">Created</th>
						<th scope="col">Last used</th>
						<th scope="col">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, sess := range d.Sessions {
						@sessionRow(sess)
					}
				</tbody>
			</table>
		</section>
		@liveStream(MeStreamPath)
	}
}

// sessionRow is one row of the table of sessions.
templ sessionRow(sess app.SessionInfo) {
	<tr id={ "session-" + strconv.FormatUint(sess.ID, 10) } data-kind={ string(sess.Kind) } class={ templ.KV("current", sess.Current) }>
		<td class="kind">{ sessionKindText(sess.Kind) }</td>
		<td class="client">
			if sess.ClientName != "" {
				{ sess.ClientName }
			} else {
				<span class="hint">Unknown</span>
			}
			if sess.Current {
				<span class="session-current">This browser</span>
			}
		</td>
		<td><time class="post-time" datetime={ postTimeStamp(sess.CreatedAt) } title={ postTimeStamp(sess.CreatedAt) }>{ postTimeText(sess.CreatedAt) }</time></td>
		<td><time class="post-time" datetime={ postTimeStamp(sess.LastSeenAt) } title={ postTimeStamp(sess.LastSeenAt) }>{ postTimeText(sess.LastSeenAt) }</time></td>
		<td class="actions">
			<form class="action" method="post" action={ templ.SafeURL(SessionEndPath(sess.ID)) }>
				<button type="submit" class="secondary">End</button>
			</form>
		</td>
	</tr>
}

// sessionKindText is "Browser" for a browser session and "App" for an API
// session.
func sessionKindText(k app.SessionKind) string {
	if k == app.SessionAPI {
		return "App"
	}
	return "Browser"
}
