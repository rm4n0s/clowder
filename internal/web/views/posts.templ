package views

import (
	"html/template"
	"strconv"

	"github.com/rm4n0s/clowder/internal/app"
)

// PostEditor is the editor of a post: the body with the Text / Markdown
// switch, the tags field with its suggestions, the preview, and the submit
// button. The server sends it alone as a Datastar patch to show the problems of
// a failed submit; what the person typed is kept. The comments, attachments
// and tasks of later steps reuse it.
templ PostEditor(d PostEditorData) {
	<form id={ "post-editor-" + d.ID } class="post-editor" method="post" enctype="multipart/form-data" action={ templ.SafeURL(d.Action) } data-on:submit={ FormPost(d.Action) }>
		@formProblem(d.Errors.Form)
		<input type="hidden" name="editor" value={ d.ID }/>
		if d.From != "" {
			<input type="hidden" name="from" value={ d.From }/>
		}
		<div class="field">
			<label for={ "post-body-" + d.ID }>Message</label>
			<textarea
				id={ "post-body-" + d.ID }
				name="body"
				rows="5"
				if d.Errors.Fields["body"] != "" {
					aria-invalid="true"
					aria-describedby={ "post-body-" + d.ID + "-error" }
				}
			>{ d.Body }</textarea>
			if d.Errors.Fields["body"] != "" {
				<p class="field-error" id={ "post-body-" + d.ID + "-error" } role="alert">{ d.Errors.Fields["body"] }</p>
			}
		</div>
		<fieldset class="format-switch">
			<legend>Format</legend>
			<label class="choice">
				<input type="radio" name="format" value="markdown" checked?={ d.Format != "text" }/>
				Markdown
			</label>
			<label class="choice">
				<input type="radio" name="format" value="text" checked?={ d.Format == "text" }/>
				Text
			</label>
			if d.Errors.Fields["format"] != "" {
				<p class="field-error" id={ "post-format-" + d.ID + "-error" } role="alert">{ d.Errors.Fields["format"] }</p>
			}
		</fieldset>
		<div class="field">
			<label for={ "post-tags-" + d.ID }>Tags</label>
			<input
				id={ "post-tags-" + d.ID }
				name="tags"
				type="text"
				value={ d.Tags }
				autocomplete="off"
				placeholder="design release"
				data-on:input__debounce.200ms={ suggestAction(d.ID) }
				if d.Errors.Fields["tags"] != "" {
					aria-invalid="true"
					aria-describedby={ "post-tags-" + d.ID + "-error" }
				}
			/>
			@TagSuggestions(d.ID, nil)
			if d.Errors.Fields["tags"] != "" {
				<p class="field-error" id={ "post-tags-" + d.ID + "-error" } role="alert">{ d.Errors.Fields["tags"] }</p>
			} else {
				<p class="hint">Separate tags with spaces or commas: up to 10 of letters, digits, - and _.</p>
			}
		</div>
		<div class="field attachments-field">
			<label for={ "post-files-" + d.ID }>Attach files</label>
			if len(d.Attachments) > 0 {
				<ul class="attachment-edit" aria-label="Current files">
					for _, a := range d.Attachments {
						<li>
							<input type="hidden" name="keep" value={ roomIDText(a.ID) }/>
							<span class="attachment-name">{ a.FileName }</span>
							<span class="hint">{ SizeText(a.Size) }</span>
							<label class="choice">
								<input type="checkbox" name="remove" value={ roomIDText(a.ID) } checked?={ d.Removing[a.ID] }/>
								Remove
							</label>
						</li>
					}
				</ul>
			}
			<input
				id={ "post-files-" + d.ID }
				name="files"
				type="file"
				multiple
				if d.Errors.Fields["attachments"] != "" {
					aria-invalid="true"
					aria-describedby={ "post-files-" + d.ID + "-error" }
				}
			/>
			if d.Errors.Fields["attachments"] != "" {
				<p class="field-error" id={ "post-files-" + d.ID + "-error" } role="alert">{ d.Errors.Fields["attachments"] }</p>
			}
		</div>
		@PostPreview(PostPreviewData{EditorID: d.ID, Hidden: true})
		<div class="post-editor-actions">
			<button type="submit">{ d.SubmitLabel }</button>
			<button type="button" class="secondary" data-on:click={ previewAction }>Preview</button>
			if d.CancelPath != "" || d.CancelClose {
				<a class="button-link" href={ templ.SafeURL(d.CancelHref) } data-on:click__prevent={ cancelAction(d) }>Cancel</a>
			}
		</div>
	</form>
}

// PostPreviewData is what the preview box of an editor shows.
type PostPreviewData struct {
	// EditorID is the ID of the editor the box belongs to.
	EditorID string
	// HTML is the rendered body, which comes from internal/markdown; empty for
	// an empty body.
	HTML template.HTML
	// Message is the problem that stopped the preview (a body that is too
	// long); empty shows none.
	Message string
	// Hidden is true for the box before the first preview.
	Hidden bool
}

// PostPreview is the preview box of an editor. The server sends it alone as a
// Datastar patch when the person asks for a preview.
templ PostPreview(d PostPreviewData) {
	<div id={ "post-preview-" + d.EditorID } class="post-preview" hidden?={ d.Hidden }>
		if !d.Hidden {
			<div class="post-preview-bar">
				<span class="hint">Preview</span>
				<button type="button" class="secondary" data-on:click={ closePreviewAction }>Close</button>
			</div>
			if d.Message != "" {
				<p class="field-error" role="alert">{ d.Message }</p>
			} else if d.HTML == "" {
				<p class="empty">Nothing to preview.</p>
			} else {
				<div class="post-body">
					@templ.Raw(string(d.HTML))
				</div>
			}
		}
	</div>
}

// TagSuggestions is the list of suggested tags under the tags field of an
// editor. The server sends it alone as a Datastar patch while the person types;
// a suggestion completes the tag being typed.
templ TagSuggestions(editorID string, tags []string) {
	<ul id={ "post-tag-suggest-" + editorID } class="tag-suggest" aria-label="Tag suggestions">
		for _, tag := range tags {
			<li>
				<button type="button" class="secondary tag-option" data-tag={ tag } data-on:click={ pickTagAction }>{ "#" + tag }</button>
			</li>
		}
	</ul>
}

// postElementID is the id of the element of a post.
func postElementID(id uint64) string {
	return "post-" + roomIDText(id)
}

// PostCard is a post or a comment: author, time, "edited", the body, the tags
// as links to their search, the comment count of a post that links to its
// thread, and Reply, Edit and Delete for the person who may. A comment is
// indented to its depth (at most MaxVisualDepth) and, below that depth, says
// whom it replies to. A post or comment that was deleted but stays because it
// has replies is the placeholder "This post was deleted." or "This comment was
// deleted." The server sends it alone as a Datastar patch after an edit, a
// cancel or a failed action.
templ PostCard(d PostCardData) {
	<article
		id={ postElementID(d.Post.ID) }
		class={ cardClasses(d) }
		data-post={ roomIDText(d.Post.ID) }
		if d.Focus {
			data-init={ scrollIntoViewAction }
		}
	>
		@PostContent(d)
		if d.CanReply && !d.Post.Deleted {
			@ReplySlot(d.Post.ID, d.Reply)
		}
	</article>
}

// PostContent is the card of a post or comment without its article and its
// reply slot: the message above it, the author and time, the body, the
// attachments, the tags and the footer with the buttons. A live update of a
// post or comment replaces only this part, so that a reply editor open in the
// slot below it, or the editor that replaced the article, is left alone.
templ PostContent(d PostCardData) {
	<div id={ postContentID(d.Post.ID) } class="post-content">
		@formProblem(d.Message)
		if d.Post.Deleted {
			<p class="post-deleted-note">{ deletedNote(d.Post) }</p>
		} else {
			<header class="post-meta">
				<span class="post-author">{ d.Post.Author.DisplayName }</span>
				<span class="post-username">{ "@" + d.Post.Author.Username }</span>
				<a class="post-time" href={ templ.SafeURL(timePath(d.Post)) }>
					<time datetime={ postTimeStamp(d.Post.CreatedAt) } title={ postTimeStamp(d.Post.CreatedAt) }>{ postTimeText(d.Post.CreatedAt) }</time>
				</a>
				if d.Post.EditedAt != nil {
					<span class="post-edited" title={ postTimeStamp(*d.Post.EditedAt) }>edited</span>
				}
			</header>
			if replyingToCapped(d) {
				if d.ParentAuthor.Username != "" {
					<p class="comment-replying">{ "replying to @" + d.ParentAuthor.Username }</p>
				} else {
					<p class="comment-replying">replying to a deleted comment</p>
				}
			}
			<div class="post-body">
				@templ.Raw(string(d.Post.HTML))
			</div>
			@Attachments(d.Post.Attachments)
			if len(d.Post.Tags) > 0 {
				<ul class="tags" aria-label="Tags">
					for _, tag := range d.Post.Tags {
						<li><a class="tag" href={ templ.SafeURL(TagSearchPath(tag)) }>{ "#" + tag }</a></li>
					}
				</ul>
			}
			<div class="reaction-bar">
				@Reactions(d.reactions())
				@ReactionPicker(d.reactions())
			</div>
		}
		<footer class="post-footer">
			if !d.Post.IsComment {
				<a class="post-comments" href={ templ.SafeURL(PostCommentsPath(d.Post.ID)) }>{ commentCountText(d.Post.CommentCount) }</a>
			}
			if d.CanReply && !d.Post.Deleted {
				<a class="post-reply" href={ templ.SafeURL(replyPath(d.Post.ID)) } data-on:click__prevent={ "@get('" + escapeQuote(replyPath(d.Post.ID)) + "')" }>Reply</a>
			}
			if d.Post.CanEdit {
				<a class="post-edit" href={ templ.SafeURL(postActionPath(d.Post.ID, "edit", d.From)) } data-on:click__prevent={ "@get('" + escapeQuote(postActionPath(d.Post.ID, "edit", d.From)) + "')" }>Edit</a>
			}
			if d.Post.CanDelete {
				<form class="action post-delete" method="post" action={ templ.SafeURL(PostPath(d.Post.ID) + "/delete") } data-on:submit={ FormPostConfirm(PostPath(d.Post.ID)+"/delete", deleteConfirm(d.Post)) }>
					if d.From != "" {
						<input type="hidden" name="from" value={ d.From }/>
					}
					<button type="submit" class="danger">Delete</button>
				</form>
			}
		</footer>
	</div>
}

// Reactions are the chips of a post or comment: one for each emoji with its
// count, highlighted when the person reacted, with the names of the people as
// its title; clicking a chip adds or removes the person's reaction. Anyone who
// has not joined the room sees the chips and cannot click them. The server
// sends it alone as a Datastar patch after a reaction and, to every open page,
// when the reactions of a post change; the picker next to it is not part of it,
// so that a live change does not close it or clear what the person typed.
templ Reactions(d ReactionsData) {
	<div id={ reactionsID(d.Post.ID) } class="reactions">
		@formProblem(d.Message)
		if len(d.Post.Reactions) > 0 {
			if d.Post.CanReact {
				<form class="reaction-chips" method="post" action={ templ.SafeURL(reactionsPath(d.Post.ID)) } data-on:submit={ FormPost(reactionsPath(d.Post.ID)) }>
					if d.From != "" {
						<input type="hidden" name="from" value={ d.From }/>
					}
					for _, r := range d.Post.Reactions {
						<button type="submit" name="emoji" value={ r.Emoji } class={ reactionClasses(r) } title={ reactionTitle(r) } aria-label={ reactionLabel(r) } aria-pressed={ strconv.FormatBool(r.Mine) }>
							<span class="reaction-emoji">{ r.Emoji }</span>
							<span class="reaction-count">{ strconv.Itoa(r.Count) }</span>
						</button>
					}
				</form>
			} else {
				<ul class="reaction-chips" aria-label="Reactions">
					for _, r := range d.Post.Reactions {
						<li class={ reactionClasses(r) } title={ reactionTitle(r) }>
							<span class="reaction-emoji">{ r.Emoji }</span>
							<span class="reaction-count">{ strconv.Itoa(r.Count) }</span>
						</li>
					}
				</ul>
			}
		}
	</div>
}

// ReactionPicker is the add button of the reaction bar of a member and the
// picker it opens: the common emoji and a field for any other emoji. It is empty
// for anyone who has not joined the room. The server sends it alone as a
// Datastar patch after the person's own reaction (which closes it) or a
// mistake in the field (which opens it); live changes of the reactions leave it
// alone.
templ ReactionPicker(d ReactionsData) {
	<div id={ reactionPickerID(d.Post.ID) } class="reaction-picker-box">
		if d.Post.CanReact {
			<details class="reaction-add" open?={ d.Problem != "" }>
				<summary title="Add a reaction" aria-label="Add a reaction">+</summary>
				<div class="reaction-picker">
					<form class="reaction-grid" method="post" action={ templ.SafeURL(reactionsPath(d.Post.ID)) } data-on:submit={ FormPost(reactionsPath(d.Post.ID)) }>
						if d.From != "" {
							<input type="hidden" name="from" value={ d.From }/>
						}
						for _, e := range pickerEmoji {
							<button type="submit" name="emoji" value={ e } class="reaction-option" aria-label={ "React with " + e }>{ e }</button>
						}
					</form>
					<form class="reaction-custom" method="post" action={ templ.SafeURL(reactionsPath(d.Post.ID)) } data-on:submit={ FormPost(reactionsPath(d.Post.ID)) }>
						if d.From != "" {
							<input type="hidden" name="from" value={ d.From }/>
						}
						<label for={ "reaction-text-" + roomIDText(d.Post.ID) }>Any emoji</label>
						<input
							id={ "reaction-text-" + roomIDText(d.Post.ID) }
							name="emoji"
							type="text"
							value={ d.Typed }
							maxlength="32"
							autocomplete="off"
							placeholder="🦄"
							if d.Problem != "" {
								aria-invalid="true"
								aria-describedby={ "reaction-text-" + roomIDText(d.Post.ID) + "-error" }
							}
						/>
						<button type="submit" class="reaction-submit">React</button>
						if d.Problem != "" {
							<p class="field-error" id={ "reaction-text-" + roomIDText(d.Post.ID) + "-error" } role="alert">{ d.Problem }</p>
						}
					</form>
				</div>
			</details>
		}
	</div>
}

// Attachments shows the files of a post or comment under its body: the images
// inline, scaled to the width of the column (the width and height attributes
// hold the size of the file, so that the page does not jump when it loads),
// each a link to the full file; then the other files as a list of links with
// their sizes.
templ Attachments(atts []app.AttachmentView) {
	{{ images, others := splitAttachments(atts) }}
	if len(images) > 0 {
		<ul class="attachment-images">
			for _, a := range images {
				<li>
					<a href={ templ.SafeURL(FilePath(a)) } target="_blank" rel="noopener">
						<img
							src={ FilePath(a) }
							alt={ a.FileName }
							loading="lazy"
							if a.Width > 0 && a.Height > 0 {
								width={ roomIDText(uint64(a.Width)) }
								height={ roomIDText(uint64(a.Height)) }
							}
						/>
					</a>
				</li>
			}
		</ul>
	}
	if len(others) > 0 {
		<ul class="attachment-files" aria-label="Files">
			for _, a := range others {
				<li>
					<a href={ templ.SafeURL(FilePath(a)) }>{ a.FileName }</a>
					<span class="hint">{ SizeText(a.Size) }</span>
				</li>
			}
		</ul>
	}
}

// ReplySlot is the place under a post or comment where the reply editor opens,
// empty until then. The server sends it alone as a Datastar patch to open the
// editor.
templ ReplySlot(parentID uint64, editor *PostEditorData) {
	<div id={ "reply-slot-" + roomIDText(parentID) } class="reply-slot">
		if editor != nil {
			@PostEditor(*editor)
		}
	</div>
}

// PostEdit is a post or comment replaced by its editor, for the edit in place.
templ PostEdit(d PostEditData) {
	<article id={ postElementID(d.Post.ID) } class={ editClasses(d) } data-post={ roomIDText(d.Post.ID) }>
		@PostEditor(d.Editor)
	</article>
}

// FeedPosts is the posts of a page of the feed, newest first, one after the
// other.
templ FeedPosts(d FeedData) {
	for _, p := range d.Page.Posts {
		@PostCard(PostCardData{Post: p})
	}
}

// FeedMore is the end of the feed. When older posts exist it is the sentinel:
// when it scrolls into view, Datastar loads the next page (the server answers
// with the posts to append and a new sentinel); without JavaScript the link
// "Older posts" opens the older page. With no older posts it is empty.
templ FeedMore(d FeedData) {
	if d.Page.HasNext {
		<div id="feed-more" class="feed-more" data-on-intersect__once={ loadMoreAction(d.RoomID, d.Page.NextBefore) }>
			<a href={ templ.SafeURL(OlderPostsPath(d.RoomID, d.Page.NextBefore)) }>Older posts</a>
		</div>
	} else {
		<div id="feed-more" class="feed-more"></div>
	}
}

// Feed is the feed of a room: the posts of the page, the empty message (shown
// by the stylesheet only while there is no post), and the end of the feed.
templ Feed(d FeedData) {
	<div id="feed" class="feed">
		if d.Before != 0 {
			<p class="hint feed-newest"><a href={ templ.SafeURL(RoomPath(d.RoomID)) }>Back to the newest posts</a></p>
		}
		<div id="feed-posts" class="feed-posts">
			@FeedPosts(d)
		</div>
		<p id="feed-empty" class="empty">No posts yet</p>
		@FeedMore(d)
	</div>
}

// postTitle is the title of the page of a post.
func postTitle(d PostPageData) string {
	if d.Post.Deleted {
		return "Deleted post in " + d.Post.RoomName
	}
	return "Post by " + d.Post.Author.DisplayName + " in " + d.Post.RoomName
}

// Thread is the post of the page and its comments, one after the other in
// reading order, each indented to its depth. The server sends it alone as a
// Datastar patch when a comment is written or deleted: the new thread replaces
// the old one.
templ Thread(d PostPageData) {
	<div id="thread" class="thread">
		@threadItem(d, d.RootCard())
		if !d.CanReply {
			<p id="join-to-reply" class="hint join-note">Join this room to reply</p>
		}
		@CommentsSection(d)
	</div>
}

// CommentsSection is the comments of the thread, or the note that there are
// none. A live update replaces it alone when the first comment arrives.
templ CommentsSection(d PostPageData) {
	<section id="comments" class="comments">
		<h2>Comments</h2>
		if len(d.Comments) == 0 {
			<p class="empty">No comments yet.</p>
		} else {
			<div class="comment-list">
				for _, c := range d.Comments {
					@threadItem(d, d.CommentCard(c))
				}
			</div>
		}
	</section>
}

// threadItem is one post or comment of the thread: its card, or its editor
// when it is being edited.
templ threadItem(d PostPageData, c PostCardData) {
	if d.Editing && c.Post.ID == d.activeID() {
		@PostEdit(PostEditData{Post: c.Post, Editor: d.Editor, Depth: c.Depth})
	} else {
		@PostCard(c)
	}
}

// PostPage is the page of a post, in the layout with the sidebar: the room it
// was written in, the post and its thread of comments. The page of a comment is
// the page of its post with that comment in focus.
templ PostPage(d PostPageData) {
	@Layout(postTitle(d), Sidebar(d.Sidebar)) {
		@liveStream(PostStreamPath(d.Post.ID, d.NewestID()))
		<p class="post-room hint">in <a href={ templ.SafeURL(RoomPath(d.Post.RoomID)) }>{ d.Post.RoomName }</a></p>
		@Thread(d)
	}
}
