package views

import (
	"net/http"
	"strconv"
)

// ErrorPage is the page shown for an HTTP error (404, 500 and the like): the
// status code and a short message, in a card under the logo. The message is
// plain text, never the text of an error.
templ ErrorPage(status int, message string) {
	@Layout(strconv.Itoa(status)+" "+http.StatusText(status), 0, nil) {
		<div class="auth-card error-card">
			<h1>{ strconv.Itoa(status) }</h1>
			<p>{ message }</p>
			<p><a href="/">Back to the home page</a></p>
		</div>
	}
}
