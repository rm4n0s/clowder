package views

import "strconv"

// GroupMentionConfirm is the question that stands above the buttons of an
// editor or of the composer when the body holds a group mention that would
// notify more than 5 people (SPEC §7.15): "This will notify 14 people. Send
// anyway?", with Send, which sends the form again with the flag
// confirm_group_mention=1 (the Send button of the page works through Datastar,
// and without JavaScript the button posts to the same address), and Cancel,
// which closes the question. With a Count of 0 it is an empty place that the
// server patches the question into.
templ GroupMentionConfirm(d GroupMentionConfirmData) {
	<div id={ GroupMentionConfirmID(d.ID) } class="group-mention-confirm" aria-live="assertive">
		if d.Count > 0 {
			<p class="group-mention-question" role="alert">{ d.Question() }</p>
			<div class="post-editor-actions">
				<button type="submit" formaction={ templ.SafeURL(d.SendPath) } data-on:click__prevent={ FormPost(d.SendPath) }>Send</button>
				<button type="button" class="secondary" data-on:click="el.closest('.group-mention-confirm').replaceChildren()">Cancel</button>
			</div>
		}
	</div>
}

// groupMentionCountText is the number of people of a question, as a number.
func groupMentionCountText(n int) string {
	return strconv.Itoa(n)
}
