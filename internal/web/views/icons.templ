package views

// The icons of the interface (SPEC D57): inline SVG, 24 by 24, drawn with a
// stroke of currentColor so that they take the colour of the text around them.
// Each is decorative (aria-hidden): the button or link that holds one has a
// text, a visually hidden text or an aria-label of its own. A few are filled
// shapes (the paw, the three dots of "more").

// icon is the svg element every icon of the set draws in: the viewBox, the
// stroke and the class "icon", which app.css sizes. The paths are the children.
templ icon() {
	<svg class="icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		{ children... }
	</svg>
}

// iconFilled is the svg element of the icons that are filled shapes.
templ iconFilled() {
	<svg class="icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
		{ children... }
	</svg>
}

// IconBell is a bell: notifications.
templ IconBell() {
	@icon() {
		<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
		<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
	}
}

// IconMessage is a speech bubble: private messages.
templ IconMessage() {
	@icon() {
		<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
	}
}

// IconSearch is a magnifying glass.
templ IconSearch() {
	@icon() {
		<circle cx="11" cy="11" r="7"></circle>
		<path d="m20 20-3.5-3.5"></path>
	}
}

// IconLock is a padlock: a private room.
templ IconLock() {
	@icon() {
		<rect x="4" y="11" width="16" height="10" rx="2"></rect>
		<path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
	}
}

// IconMuted is a bell crossed out: a muted room or conversation.
templ IconMuted() {
	@icon() {
		<path d="M18 11.5c0 5.5 3 5.5 3 5.5H8"></path>
		<path d="M6.6 8.6C6.2 14.5 3 17 3 17h2"></path>
		<path d="M8.5 4.6A6 6 0 0 1 18 8v1"></path>
		<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
		<path d="m3 3 18 18"></path>
	}
}

// emptyState is the quiet box of a list with nothing in it: the paw mark above
// the message, which the caller gives as its child.
templ emptyState() {
	<div class="empty-state">
		<span class="empty-mark">
			@IconPaw()
		</span>
		{ children... }
	</div>
}

// IconPaw is a paw print: the mark of Clowder, filled.
templ IconPaw() {
	@iconFilled() {
		<ellipse cx="12" cy="16" rx="5" ry="4"></ellipse>
		<circle cx="6" cy="10" r="2"></circle>
		<circle cx="10" cy="6.5" r="2"></circle>
		<circle cx="14" cy="6.5" r="2"></circle>
		<circle cx="18" cy="10" r="2"></circle>
	}
}

// IconHeart is a heart.
templ IconHeart() {
	@icon() {
		<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path>
	}
}

// IconAttach is a paperclip: attach a file.
templ IconAttach() {
	@icon() {
		<path d="m21.4 11-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"></path>
	}
}

// IconMore is three dots: more actions, filled.
templ IconMore() {
	@iconFilled() {
		<circle cx="5" cy="12" r="2"></circle>
		<circle cx="12" cy="12" r="2"></circle>
		<circle cx="19" cy="12" r="2"></circle>
	}
}

// IconSettings is two sliders: settings.
templ IconSettings() {
	@icon() {
		<path d="M4 7h8M18 7h2M4 17h2M12 17h8"></path>
		<circle cx="15" cy="7" r="2.5"></circle>
		<circle cx="9" cy="17" r="2.5"></circle>
	}
}

// IconLogout is an arrow leaving a frame: log out.
templ IconLogout() {
	@icon() {
		<path d="M10 4H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h3"></path>
		<path d="M11 12h10"></path>
		<path d="m17 8 4 4-4 4"></path>
	}
}

// IconSun is a sun: the light theme.
templ IconSun() {
	@icon() {
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
	}
}

// IconMoon is a crescent moon: the dark theme.
templ IconMoon() {
	@icon() {
		<path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
	}
}

// IconMonitor is a screen: the theme of the system.
templ IconMonitor() {
	@icon() {
		<rect x="3" y="4" width="18" height="12" rx="2"></rect>
		<path d="M8 20h8M12 16v4"></path>
	}
}

// IconPlus is a plus sign.
templ IconPlus() {
	@icon() {
		<path d="M12 5v14M5 12h14"></path>
	}
}

// IconCheck is a check mark.
templ IconCheck() {
	@icon() {
		<path d="m5 12.5 4.5 4.5L19 7.5"></path>
	}
}

// IconClose is a cross: close or remove.
templ IconClose() {
	@icon() {
		<path d="M6 6l12 12M18 6 6 18"></path>
	}
}

// IconMenu is three bars: the menu of a phone.
templ IconMenu() {
	@icon() {
		<path d="M4 7h16M4 12h16M4 17h16"></path>
	}
}

// IconBoard is three columns of different heights: the board of a room.
templ IconBoard() {
	@icon() {
		<rect x="3" y="4" width="5" height="16" rx="1.5"></rect>
		<rect x="10" y="4" width="5" height="10" rx="1.5"></rect>
		<rect x="17" y="4" width="4" height="13" rx="1.5"></rect>
	}
}

// IconFeed is two stacked cards: the feed of a room.
templ IconFeed() {
	@icon() {
		<rect x="3" y="4" width="18" height="7" rx="2"></rect>
		<rect x="3" y="14" width="18" height="6" rx="2"></rect>
	}
}

// IconTag is a label with a hole: a tag.
templ IconTag() {
	@icon() {
		<path d="M3 11.2V5a2 2 0 0 1 2-2h6.2a2 2 0 0 1 1.4.6l7.8 7.8a2 2 0 0 1 0 2.8l-6.2 6.2a2 2 0 0 1-2.8 0l-7.8-7.8a2 2 0 0 1-.6-1.4z"></path>
		<circle cx="7.5" cy="7.5" r="1.3"></circle>
	}
}

// IconCalendar is a calendar page: a due date.
templ IconCalendar() {
	@icon() {
		<rect x="3" y="5" width="18" height="16" rx="3"></rect>
		<path d="M3 10h18M8 3v4M16 3v4"></path>
	}
}

// IconFile is a page with a folded corner: a file.
templ IconFile() {
	@icon() {
		<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
		<path d="M14 3v5h5"></path>
	}
}

// IconTask is an empty box: a task that is open.
templ IconTask() {
	@icon() {
		<rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
	}
}

// IconTaskDone is a box with a check mark: a task that is done.
templ IconTaskDone() {
	@icon() {
		<rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
		<path d="m8 12.5 3 3 5-6"></path>
	}
}

// IconPhone is a telephone handset: an audio call.
templ IconPhone() {
	@icon() {
		<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path>
	}
}

// IconHangUp is a handset turned down: hang up and decline.
templ IconHangUp() {
	@icon() {
		<path d="M10.7 13.3a16 16 0 0 1-2.6-3.4l1.3-1.3a2 2 0 0 0 .5-2.1c-.3-.9-.6-1.8-.7-2.8A2 2 0 0 0 7.2 2.1H4.2"></path>
		<path d="M14.6 9.4a16 16 0 0 1 4.2 2.7"></path>
		<path d="M22 16.9v3a2 2 0 0 1-2.2 2c-1.8-.2-3.5-.7-5.1-1.5"></path>
		<path d="m2 2 20 20"></path>
	}
}

// IconVideo is a camera: a video call, and the camera that is on.
templ IconVideo() {
	@icon() {
		<path d="m16 13 5.2 3.5a.5.5 0 0 0 .8-.4V7.9a.5.5 0 0 0-.8-.4L16 11"></path>
		<rect x="2" y="6" width="14" height="12" rx="2"></rect>
	}
}

// IconVideoOff is a camera crossed out: the camera that is off.
templ IconVideoOff() {
	@icon() {
		<path d="M10.7 6H14a2 2 0 0 1 2 2v3.3l5.2-3.8a.5.5 0 0 1 .8.4v8.2"></path>
		<path d="M16 16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2"></path>
		<path d="m2 2 20 20"></path>
	}
}

// IconMic is a microphone: the microphone that is on.
templ IconMic() {
	@icon() {
		<rect x="9" y="2" width="6" height="12" rx="3"></rect>
		<path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
		<path d="M12 18v4"></path>
	}
}

// IconMicOff is a microphone crossed out: the microphone that is off.
templ IconMicOff() {
	@icon() {
		<path d="M9 9v2a3 3 0 0 0 5.1 2.1"></path>
		<path d="M15 9.3V5a3 3 0 0 0-5.7-1.3"></path>
		<path d="M19 10v1a7 7 0 0 1-.9 3.4"></path>
		<path d="M5 10v1a7 7 0 0 0 11 5.7"></path>
		<path d="M12 18v4"></path>
		<path d="m2 2 20 20"></path>
	}
}

// IconScreen is a monitor with an arrow: share the screen.
templ IconScreen() {
	@icon() {
		<rect x="2" y="3" width="20" height="14" rx="2"></rect>
		<path d="M8 21h8"></path>
		<path d="M12 17v4"></path>
		<path d="m8.5 10.5 3.5-3.5 3.5 3.5"></path>
		<path d="M12 7v6"></path>
	}
}

// IconSliders is two sliders: the choice of the devices.
templ IconSliders() {
	@icon() {
		<path d="M4 6h10"></path>
		<path d="M18 6h2"></path>
		<circle cx="16" cy="6" r="2"></circle>
		<path d="M4 18h2"></path>
		<path d="M10 18h10"></path>
		<circle cx="8" cy="18" r="2"></circle>
		<path d="M4 12h4"></path>
		<path d="M12 12h8"></path>
		<circle cx="10" cy="12" r="2"></circle>
	}
}
