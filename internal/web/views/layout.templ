package views

// Layout is the HTML page every page is rendered in: the head with the title
// (which starts with "(n) " while unread is above 0, the number of unread
// notifications and conversations of the person, SPEC §7.17) and the favicon
// (with a dot while unread is above 0), the stylesheets (app.css, and code.css for the code blocks), the Datastar
// client and code.js (the toolbar of the code blocks) and the shell of the
// page (SPEC D57). With sb, the page of a logged-in person, the shell is the
// header (the logo, the search box, the bell, Messages and the user menu), the
// aside of the sidebar with the rooms and the main element for the children.
// Without it, the pages of people who are not logged in and the error pages,
// the shell is a main element with the logo above the card of the children.
// The html element carries data-theme when the context has a theme
// (WithTheme).
templ Layout(title string, unread int, sb *SidebarData) {
	<!DOCTYPE html>
	<html
		lang="en"
		if themeOf(ctx) != "" {
			data-theme={ themeOf(ctx) }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			@ThemeColor()
			<link rel="manifest" href="/manifest.webmanifest"/>
			@PageTitle(unread, PageBaseTitle(title))
			@Favicon(unread)
			<link rel="alternate icon" type="image/png" sizes="32x32" href={ templ.SafeURL(StaticURL(ctx, "/static/favicon-32.png")) }/>
			<link rel="apple-touch-icon" sizes="180x180" href={ templ.SafeURL(StaticURL(ctx, "/static/apple-touch-icon.png")) }/>
			<link rel="stylesheet" href={ templ.SafeURL(StaticURL(ctx, "/static/app.css")) }/>
			<link rel="stylesheet" href={ templ.SafeURL(StaticURL(ctx, "/static/code.css")) }/>
			<script type="module" src={ StaticURL(ctx, "/static/datastar.js") }></script>
			<script src={ StaticURL(ctx, "/static/code.js") } defer></script>
			if sb != nil {
				<script src={ StaticURL(ctx, "/static/notify.js") } defer></script>
			}
		</head>
		<body>
			if sb != nil {
				@PageHeader(*sb)
				<div class="shell">
					@PageSidebar(*sb)
					// The streams append here what the script rings for (SPEC §7.15); it is never patched itself.
					<div id="notify-events" hidden></div>
					// The slot of the dialog of a call that rings for the user (SPEC §7.18); the stream patches it.
					@CallRingingSlot(sb.Ringing)
					<main>
						{ children... }
					</main>
				</div>
			} else {
				<div class="plain-shell">
					<main>
						<p class="plain-logo">
							@Logo()
						</p>
						{ children... }
					</main>
				</div>
			}
		</body>
	</html>
}

// liveStream is the element that opens the live stream of a page: when the
// page loads, Datastar opens the stream at path and applies the patches it
// sends. The element is never patched, so the stream is opened once.
templ liveStream(path string) {
	<div id="live-stream" hidden data-init={ streamAction(path) }></div>
}

// PageTitle is the title element of a page: "(n) " when unread is above 0,
// then base, the name of the page with the name of the site. It has an id so
// that the stream can patch it when the count changes.
templ PageTitle(unread int, base string) {
	<title id="page-title">{ TabTitle(unread, base) }</title>
}

// Favicon is the link element of the favicon: the plain one, or the one with a
// dot while unread is above 0. It has an id so that the stream can patch it
// when the count changes.
templ Favicon(unread int) {
	<link id="favicon" rel="icon" type="image/svg+xml" href={ templ.SafeURL(StaticURL(ctx, FaviconPath(unread))) }/>
}

// ThemeColor writes the theme-color elements of the head: one with the colour
// of the theme the person chose (Light or Dark), or, for System, one for each
// palette, chosen by prefers-color-scheme. The theme form patches nothing here;
// it replaces the elements through script (the answer of the theme form).
templ ThemeColor() {
	switch themeOf(ctx) {
		case "light":
			<meta name="theme-color" content={ ThemeColorLight }/>
		case "dark":
			<meta name="theme-color" content={ ThemeColorDark }/>
		default:
			<meta name="theme-color" content={ ThemeColorLight } media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content={ ThemeColorDark } media="(prefers-color-scheme: dark)"/>
	}
}
