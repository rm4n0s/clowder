package views

// Layout is the HTML page every page is rendered in: the head with the title,
// the stylesheets (app.css, and code.css for the code blocks), the Datastar
// client and code.js (the toolbar of the code blocks), an aside for the
// sidebar (only when there is one: the pages of people who are not logged in
// have none) and a
// main element for the children. The html element carries data-theme when the
// context has a theme (WithTheme).
templ Layout(title string, sidebar templ.Component) {
	<!DOCTYPE html>
	<html
		lang="en"
		if themeOf(ctx) != "" {
			data-theme={ themeOf(ctx) }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Clowder</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/code.css"/>
			<script type="module" src="/static/datastar.js"></script>
			<script src="/static/code.js" defer></script>
			if sidebar != nil {
				<script src="/static/notify.js" defer></script>
			}
		</head>
		<body>
			if sidebar != nil {
				<aside id="sidebar">
					@sidebar
				</aside>
				// The streams append here what the script rings for (SPEC §7.15); it is never patched itself.
				<div id="notify-events" hidden></div>
			}
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// liveStream is the element that opens the live stream of a page: when the
// page loads, Datastar opens the stream at path and applies the patches it
// sends. The element is never patched, so the stream is opened once.
templ liveStream(path string) {
	<div id="live-stream" hidden data-init={ streamAction(path) }></div>
}
