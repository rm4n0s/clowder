# The settings of `docker compose up`. Copy this file to .env and change it:
#
#   cp .env.example .env
#
# .env is not committed (it is in .gitignore). Compose reads it by itself.

# ---- PostgreSQL ----

# The password of the database user. Compose refuses to start without it.
# Change it: use a long random string (for example `openssl rand -hex 24`),
# with letters and digits only, because it becomes a part of the database URL.
CLOWDER_DB_PASSWORD=change-me-to-a-long-random-password

# The database user and the database name. The defaults are fine.
CLOWDER_DB_USER=clowder
CLOWDER_DB_NAME=clowder

# ---- Clowder ----

# The address that people type in their browser. Invitation links are built
# from it, and the cookies are marked Secure when it starts with https://.
# Behind a reverse proxy with TLS this is the public https:// address.
CLOWDER_BASE_URL=http://localhost:8080

# The port on this machine where Clowder is published. Inside the container it
# always listens on 8080. Keep it in step with CLOWDER_BASE_URL when you do not
# use a proxy (http://localhost:8081 for 8081). With compose.cluster.yaml, Caddy
# publishes this port, in front of two Clowder processes.
CLOWDER_PORT=8080

# The port on this machine where the SSH server of the sign-in codes is
# published (inside the container it listens on 2222). `ssh -p 2222
# alice@chat.example.org` gives a user with a registered key a one-time code.
# In the cluster composition only the first Clowder process runs it.
CLOWDER_SSH_PORT=2222

# ---- Calls (video and voice calls in private messages) ----

# The public address of this machine as the people who call reach it: its
# public IP address, or its LAN address when everybody is in one network. The
# media server announces it to the browsers; without it, calls connect only
# between people who can reach the container's own address (the same machine).
# Leave it empty to announce the addresses of the container.
CLOWDER_MEDIA_PUBLIC_IP=

# The port on this machine for the media of the calls: published for UDP and for
# TCP (the TCP port is the fallback for people behind a firewall that blocks
# UDP). Keep it the same inside and outside the container: the server
# announces the port it listens on, which is 7882. Open both in your firewall.
# Not used by compose.cluster.yaml: calls are off in a cluster until step 22.3.
CLOWDER_MEDIA_PORT=7882

# Set to true only when a reverse proxy of yours sits in front of Clowder and
# sets X-Forwarded-For; then the login limiter counts the real client address.
# Never set it when people reach Clowder directly: they could fake the address.
CLOWDER_TRUST_PROXY=false

# The log level: debug, info, warn or error.
CLOWDER_LOG_LEVEL=info
